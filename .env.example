# API URL the frontend connects to
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# WebSocket URL the frontend connects to
NEXT_PUBLIC_SOCKET_URL=ws://localhost:8080/entries

# URL used by NextAuth (must match the frontend URL in the environment)
NEXTAUTH_URL=http://localhost:3000

# Secret used by NextAuth (replace with a secure string in production)
NEXTAUTH_SECRET=your_nextauth_secret_here
