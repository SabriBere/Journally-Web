# Application environment
APP_ENV=development

# Public app URL (where the frontend runs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API URL the frontend connects to
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# URL used by NextAuth (must match the frontend URL in the environment)
NEXTAUTH_URL=http://localhost:3000

# Secret used by NextAuth (replace with a secure string in production)
NEXTAUTH_SECRET=your_nextauth_secret_here

# Application version (read from package.json through npm_package_version)
NEXT_PUBLIC_APP_VERSION=$npm_package_version
